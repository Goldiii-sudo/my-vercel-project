{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "memory": 256,
      "maxDuration": 30,
      "includeFiles": "{data,templates,music}/**"
    },
    "api/mux.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{data,templates,music,node_modules/ffmpeg-static}/**"
    }
  }
}
